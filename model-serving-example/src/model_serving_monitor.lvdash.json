{
  "datasets": [
    {
      "name": "summary_kpis",
      "displayName": "Summary KPIs",
      "queryLines": [
        "SELECT ",
        "  count(*) as total_requests, ",
        "  round(avg(execution_duration_ms), 1) as avg_latency_ms, ",
        "  round(sum(CASE WHEN status_code != 200 THEN 1 ELSE 0 END) * 100.0 / count(*), 1) as error_rate_pct ",
        "FROM main.rob_test.model_serving_payload"
      ]
    },
    {
      "name": "latency_percentiles",
      "displayName": "Latency Percentiles",
      "queryLines": [
        "SELECT ",
        "  round(percentile_approx(execution_duration_ms, 0.5), 1) as p50_ms, ",
        "  round(percentile_approx(execution_duration_ms, 0.95), 1) as p95_ms, ",
        "  round(percentile_approx(execution_duration_ms, 0.99), 1) as p99_ms, ",
        "  max(execution_duration_ms) as max_ms ",
        "FROM main.rob_test.model_serving_payload"
      ]
    },
    {
      "name": "requests_over_time",
      "displayName": "Requests Over Time",
      "queryLines": [
        "SELECT ",
        "  date_trunc('HOUR', request_time) as request_hour, ",
        "  count(*) as request_count, ",
        "  round(avg(execution_duration_ms), 1) as avg_latency_ms ",
        "FROM main.rob_test.model_serving_payload ",
        "GROUP BY 1 ",
        "ORDER BY 1"
      ]
    },
    {
      "name": "latency_distribution",
      "displayName": "Latency Distribution",
      "queryLines": [
        "SELECT ",
        "  CAST(execution_duration_ms AS STRING) as latency_ms, ",
        "  count(*) as request_count ",
        "FROM main.rob_test.model_serving_payload ",
        "GROUP BY 1 ",
        "ORDER BY CAST(latency_ms AS INT)"
      ]
    },
    {
      "name": "status_codes",
      "displayName": "Status Code Distribution",
      "queryLines": [
        "SELECT ",
        "  CAST(status_code AS STRING) as status_code, ",
        "  count(*) as request_count ",
        "FROM main.rob_test.model_serving_payload ",
        "GROUP BY 1 ",
        "ORDER BY 2 DESC"
      ]
    },
    {
      "name": "match_types",
      "displayName": "Match Type Distribution",
      "queryLines": [
        "SELECT pred.match_type as match_type, count(*) as cnt ",
        "FROM ( ",
        "  SELECT explode(from_json(get_json_object(response, '$.predictions'), ",
        "    'ARRAY<STRUCT<match_type: STRING, recommended_items: STRING>>')) as pred ",
        "  FROM main.rob_test.model_serving_payload ",
        "  WHERE status_code = 200 ",
        ") ",
        "GROUP BY 1 ",
        "ORDER BY 2 DESC"
      ]
    },
    {
      "name": "recent_requests",
      "displayName": "Recent Requests",
      "queryLines": [
        "SELECT ",
        "  databricks_request_id, ",
        "  request_time, ",
        "  CAST(status_code AS STRING) as status_code, ",
        "  execution_duration_ms, ",
        "  requester ",
        "FROM main.rob_test.model_serving_payload ",
        "ORDER BY request_time DESC ",
        "LIMIT 50"
      ]
    }
  ],
